# Activer le moteur de réécriture
RewriteEngine On

# 1. Masquer l'extension .php
# Si le fichier sans .php existe, on l'affiche en interne
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Si quelqu'un tape explicitement .php dans l'URL, on le redirige vers l'URL propre
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Rediriger n'importe quelle URL invalide vers la page d'accueil
# (Si le dossier ou le fichier demandé n'existe pas, renvoyer vers index.php ou index.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /index.php [R=302,L]